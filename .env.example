# supermeet: salin file ini jadi `.env`, isi yang perlu, sisanya boleh dibiarkan.
#   cp .env.example .env
#
# Format: KEY=value, satu per baris. Baris berawalan # itu komentar.
# Variabel yang sudah di-export di shell selalu menang atas isi file ini.
# Nilai kosong (KEY=) dianggap belum diisi. Jangan commit file .env.

# ---------------------------------------------------------------------------
# Yang paling penting
# ---------------------------------------------------------------------------

# Wajib buat ringkasan batch (Gemini). Gratis, bikin di https://aistudio.google.com/apikey
# Kalau kosong, ringkasan ditolak; pilih "Transcribe only" di `supermeet.py watch`
# (atau --transcribe-only) kalau cuma butuh PDF transkrip.
# GOOGLE_API_KEY juga dibaca sebagai cadangan kalau GEMINI_API_KEY kosong.
GEMINI_API_KEY=

# Token Hugging Face, dipakai buat diarization (siapa yang ngomong, via pyannote).
# Kalau kosong, diarization di-skip dan transkrip tetap jalan tanpa label speaker.
# Bikin token (read) di https://huggingface.co/settings/tokens, lalu buka halaman
# model pyannote/speaker-diarization-3.1 (dan model pyannote yang dia pakai,
# misal pyannote/segmentation-3.0) di huggingface.co, lalu setujui syaratnya.
# Tanpa itu, download model-nya ditolak.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Personalisasi
# ---------------------------------------------------------------------------

# Nama yang dipakai di prompt ringkasan dan asisten live ("bantu <nama> meringkas...").
# SUPERMEET_USER_NAME=user

# Model Gemini buat ringkasan batch. Pilihan yang ditawarkan `supermeet.py watch`
# biasanya meng-override ini per sesi.
# SUPERMEET_GEMINI_MODEL=gemini-3.8-flash

# Konteks atau permintaan tambahan buat ringkasan, ditambahkan di akhir prompt.
# Kalau dikosongkan, `supermeet.py watch` bakal nanya per sesi.
# SUPERMEET_EXTRA_PROMPT=

# Detik maksimal nunggu respons Gemini untuk satu permintaan ringkasan.
# SUPERMEET_API_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Folder (batch)
# ---------------------------------------------------------------------------

# Kalau semua dikosongkan: folder cloud dideteksi otomatis, dicek berurutan:
#   WSL : Google Drive "My Drive/whisper" atau iCloudDrive/whisper di /mnt/c/Users/*/
#   Mac : ~/Library/CloudStorage/GoogleDrive-*/My Drive/whisper (Google Drive for desktop),
#         ~/Google Drive/My Drive/whisper (klien lama),
#         ~/Library/Mobile Documents/com~apple~CloudDocs/whisper (iCloud Drive)
# Kalau tidak ada satu pun, dipakai folder ./whisper di dalam repo ini.
# Google Drive harus mode "Mirror files", bukan "Stream files".
# Di Mac, kalau Terminal ditolak aksesnya ke folder cloud: System Settings > Privacy
# & Security > Files and Folders (atau Full Disk Access), izinkan Terminal.
#
# Isi di dalam root: transcribe-inbox/ (taruh audio di sini),
# transcribe-output/summaries/ dan transcribe-output/transcripts/ (hasil PDF).

# Root folder; inbox dan output dibuat di bawahnya.
# TRANSCRIBE_CLOUD_ROOT=/path/ke/folder/whisper

# Override per folder kalau layoutnya beda dari default di atas.
# TRANSCRIBE_INBOX=/path/ke/inbox
# TRANSCRIBE_OUTPUT=/path/ke/output/summaries
# TRANSCRIBE_TRANSCRIPT_OUTPUT=/path/ke/output/transcripts

# ---------------------------------------------------------------------------
# Device dan model Whisper (batch dan kuliah) + GPU lock
# ---------------------------------------------------------------------------

# Transkripsi jalan di mana: auto (default), cuda, atau cpu.
# auto = pakai GPU NVIDIA kalau ada, kalau tidak (misalnya MacBook, atau laptop
# tanpa NVIDIA) jalan di CPU. Mac selalu CPU: ctranslate2 tidak punya backend GPU Apple.
# SUPERMEET_DEVICE=auto

# Model Whisper buat batch dan kuliah. Kalau dikosongkan, dipilih dari device:
#   cuda -> large-v3 (paling akurat)
#   cpu  -> large-v3-turbo (jauh lebih cepat; large-v3 di CPU butuh berjam-jam per rekaman)
# Model di-download otomatis pas pertama dipakai (beberapa GB).
# Isi nama model faster-whisper lain kalau mau, misal medium atau small buat lebih ringan.
# SUPERMEET_WHISPER_MODEL=large-v3-turbo

# Batch dan realtime berbagi satu lock GPU supaya tidak rebutan VRAM.

# Detik maksimal batch nunggu GPU kosong sebelum menyerah (watcher coba lagi di poll berikutnya).
# SUPERMEET_GPU_WAIT=1800

# Lokasi file lock GPU.
# SUPERMEET_GPU_LOCK=/tmp/supermeet-gpu.lock

# ---------------------------------------------------------------------------
# Realtime (asisten meeting live)
# ---------------------------------------------------------------------------

# Key Anthropic buat ringkasan dan pertanyaan live (Claude).
# Bikin di https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Opsional: kalau diisi, panggilan Claude lewat OpenRouter, bukan langsung ke Anthropic.
# Id model-nya otomatis berganti ke format OpenRouter (anthropic/claude-haiku-5.5).
# OPENROUTER_API_KEY=

# Alamat dan port server web. 0.0.0.0 artinya bisa diakses dari perangkat lain di jaringan.
# RTSM_HOST=0.0.0.0
# RTSM_PORT=8848

# Model dan effort Claude. Kalau pertanyaan buat host terasa generik, coba
# naikkan RTSM_CLAUDE_EFFORT ke medium sebelum ganti ke model yang lebih besar.
# Default model: claude-haiku-5-5 (atau anthropic/claude-haiku-5.5 kalau lewat OpenRouter).
# RTSM_CLAUDE_MODEL=claude-haiku-5-5
# RTSM_CLAUDE_EFFORT=low

# Seberapa sering ringkasan dan pertanyaan diperbarui (detik), dan minimal berapa
# karakter transkrip baru sebelum Claude dipanggil lagi.
# RTSM_SUMMARY_INTERVAL=60.0
# RTSM_QUESTIONS_INTERVAL=45.0
# RTSM_MIN_NEW_CHARS=350

# Speech-to-text. Kalau tidak ada GPU, pakai RTSM_WHISPER_DEVICE=cpu dan
# RTSM_WHISPER_COMPUTE=int8 (dan model yang lebih kecil, misal small).
# RTSM_WHISPER_MODEL=large-v3-turbo
# RTSM_WHISPER_DEVICE=cuda
# RTSM_WHISPER_COMPUTE=int8
# RTSM_LANGUAGE=id

# Batas waktu tunggu (detik): nunggu batch melepas GPU, memuat model Whisper,
# dan nunggu handoff arsip sebelum sesi baru jalan tetap.
# RTSM_GPU_WAIT_TIMEOUT=1800.0
# RTSM_MODEL_LOAD_TIMEOUT=180.0
# RTSM_HANDOFF_WAIT_TIMEOUT=600.0

# ---------------------------------------------------------------------------
# Kuliah (`supermeet.py kuliah` dan halaman upload)
# ---------------------------------------------------------------------------

# Folder rekaman yang di-upload, dan folder hasil transkrip. Default di dalam repo.
# KULIAH_UPLOADS=/path/ke/kuliah-uploads
# KULIAH_OUTPUT=/path/ke/kuliah-output

# Tipe compute Whisper buat kuliah. float16 lebih akurat tapi butuh VRAM lebih besar.
# KULIAH_COMPUTE=int8

# Lokasi file lock supaya cuma satu proses kuliah jalan.
# KULIAH_LOCK=/tmp/supermeet-kuliah.lock
